
-- ============================================================
-- COMPRAS P0 FIX — 5 CRITICAL ISSUES
-- C1) list_purchase_orders_cursor — add assert_tenant()
-- C2) list_solic_compra_mercado_cursor — add assert_tenant()
-- C3) get_supplier_ranking — add assert_tenant()
-- C4) purchase_reminders SELECT USING(true) → tenant-safe
