
-- 1) Audit triggers on uncovered tables
DO $$ BEGIN
  -- purchase_requisitions
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_purchase_requisitions') THEN
    CREATE TRIGGER audit_purchase_requisitions
      AFTER INSERT OR UPDATE OR DELETE ON public.purchase_requisitions
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'purchase_requisitions');
  END IF;

  -- purchase_requisition_items
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_purchase_requisition_items') THEN
    CREATE TRIGGER audit_purchase_requisition_items
      AFTER INSERT OR UPDATE OR DELETE ON public.purchase_requisition_items
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'purchase_requisition_items');
  END IF;

  -- purchase_reminders
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_purchase_reminders') THEN
    CREATE TRIGGER audit_purchase_reminders
      AFTER INSERT OR UPDATE OR DELETE ON public.purchase_reminders
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'purchase_reminders');
  END IF;

  -- supplier_item_prices
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_supplier_item_prices') THEN
    CREATE TRIGGER audit_supplier_item_prices
      AFTER INSERT OR UPDATE OR DELETE ON public.supplier_item_prices
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'supplier_item_prices');
  END IF;

  -- confirmacoes_recebimento
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_confirmacoes_recebimento') THEN
    CREATE TRIGGER audit_confirmacoes_recebimento
      AFTER INSERT OR UPDATE OR DELETE ON public.confirmacoes_recebimento
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'confirmacoes_recebimento');
  END IF;

  -- aprovacoes_solic_compra_mercado
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_aprovacoes_solic_compra_mercado') THEN
    CREATE TRIGGER audit_aprovacoes_solic_compra_mercado
      AFTER INSERT OR UPDATE OR DELETE ON public.aprovacoes_solic_compra_mercado
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'aprovacoes_solic_compra_mercado');
  END IF;

  -- suppliers
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'audit_suppliers') THEN
    CREATE TRIGGER audit_suppliers
      AFTER INSERT OR UPDATE OR DELETE ON public.suppliers
      FOR EACH ROW EXECUTE FUNCTION public.audit_trigger_fn('purchases', 'suppliers');
  END IF;
END $$;

-- 2) Validation triggers (instead of CHECK constraints for safety)
CREATE OR REPLACE FUNCTION public.validate_purchase_order_item()
  RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $fn$
BEGIN
  IF NEW.qty_requested <= 0 THEN
    RAISE EXCEPTION 'qty_requested deve ser > 0 (recebido: %)', NEW.qty_requested;
  END IF;
  IF NEW.estimated_unit_value < 0 THEN
    RAISE EXCEPTION 'estimated_unit_value não pode ser negativo';
  END IF;
  RETURN NEW;
END;
$fn$;

DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_validate_poi') THEN
    CREATE TRIGGER trg_validate_poi BEFORE INSERT OR UPDATE ON public.purchase_order_items
      FOR EACH ROW EXECUTE FUNCTION public.validate_purchase_order_item();
  END IF;
END $$;

CREATE OR REPLACE FUNCTION public.validate_supplier_item_price()
  RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path TO 'public'
AS $fn$
BEGIN
  IF NEW.unit_cost < 0 THEN
    RAISE EXCEPTION 'unit_cost não pode ser negativo em supplier_item_prices';
  END IF;
  RETURN NEW;
END;
$fn$;

DO $$ BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgname = 'trg_validate_sip') THEN
    CREATE TRIGGER trg_validate_sip BEFORE INSERT OR UPDATE ON public.supplier_item_prices
      FOR EACH ROW EXECUTE FUNCTION public.validate_supplier_item_price();
  END IF;
END $$;

-- 3) Fix race condition in storno RPC: add FOR UPDATE locks
CREATE OR REPLACE FUNCTION public.storno_purchase_order_stock(p_order_id uuid, p_user_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_mov RECORD;
  v_count int := 0;
BEGIN
  IF auth.uid() IS NULL THEN RAISE EXCEPTION 'Não autenticado.'; END IF;
  IF NOT public.has_permission(auth.uid(), 'purchases:create') AND NOT public.has_permission(auth.uid(), 'stock:edit') THEN
    RAISE EXCEPTION 'Sem permissão para estornar movimentações de pedido.';
  END IF;

  -- Lock the order first to prevent concurrent storno
  PERFORM 1 FROM purchase_orders WHERE id = p_order_id FOR UPDATE;

  FOR v_mov IN
    SELECT * FROM movimentacoes_estoque
    WHERE (
      (reference_type = 'PURCHASE_ORDER' AND reference_id = p_order_id::text)
      OR
      (reference_type = 'PURCHASE_ORDER_ITEM' AND reference_id LIKE 'POI:%' AND EXISTS (
        SELECT 1 FROM purchase_order_items poi
        WHERE poi.order_id = p_order_id
          AND 'POI:' || poi.id::text = movimentacoes_estoque.reference_id
      ))
    )
    AND status = 'ATIVO'
    AND tipo NOT IN ('ENTRADA_ESTORNO', 'SAIDA_ESTORNO')
    FOR UPDATE  -- lock each movement row
  LOOP
    UPDATE movimentacoes_estoque SET status = 'CANCELADO', cancelado_em = now(), cancelado_por = p_user_id, justificativa_cancelamento = 'Exclusão de pedido de compra' WHERE id = v_mov.id;
    INSERT INTO movimentacoes_estoque (produto_id, data, tipo, quantidade, custo_unitario, custo_total, origem, observacao, created_by, status, estorno_de_id, reference_type, reference_id, internal_transfer, source_module)
    VALUES (v_mov.produto_id, CURRENT_DATE, 'ENTRADA_ESTORNO', v_mov.quantidade, v_mov.custo_unitario, v_mov.custo_total, 'ESTORNO', 'Estorno automático — Exclusão pedido compra ' || p_order_id::text, p_user_id, 'ATIVO', v_mov.id, v_mov.reference_type, v_mov.reference_id || '_ESTORNO', false, 'purchases');
    v_count := v_count + 1;
  END LOOP;

  PERFORM public.log_audit('rpc', 'compras', 'purchase_orders', p_order_id, 'STORNO', NULL,
    jsonb_build_object('movimentacoes_estornadas', v_count));
END;
$function$;

-- 4) Batch mark notifications as read RPC
CREATE OR REPLACE FUNCTION public.mark_all_notifications_read()
  RETURNS INT
  LANGUAGE plpgsql
  SECURITY DEFINER
  SET search_path TO 'public'
AS $fn$
DECLARE
  v_count INT;
BEGIN
  IF auth.uid() IS NULL THEN RAISE EXCEPTION 'Não autenticado.'; END IF;

  UPDATE notifications
  SET read_at = now()
  WHERE recipient_user_id = auth.uid()::text
    AND read_at IS NULL;

  GET DIAGNOSTICS v_count = ROW_COUNT;
  RETURN v_count;
END;
$fn$;
