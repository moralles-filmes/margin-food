
-- ═══════════════════════════════════════════════════════════════
-- INVENTÁRIO ENTERPRISE HARDENING — C1 + H1 + H2 + H3 + W3
-- ═══════════════════════════════════════════════════════════════

-- ── C1: audit_inventario_log — add company_id, backfill, new RLS ──

ALTER TABLE public.audit_inventario_log
  ADD COLUMN IF NOT EXISTS company_id uuid;

-- Backfill from inventarios via inventario_id
UPDATE public.audit_inventario_log ail
SET company_id = i.company_id
FROM public.inventarios i
WHERE ail.inventario_id = i.id
  AND ail.company_id IS NULL;

-- Backfill orphans from profiles via user_id
UPDATE public.audit_inventario_log ail
SET company_id = p.company_id
FROM public.profiles p
WHERE ail.user_id = p.id
  AND ail.company_id IS NULL;

-- Now set NOT NULL + DEFAULT
ALTER TABLE public.audit_inventario_log
  ALTER COLUMN company_id SET NOT NULL,
  ALTER COLUMN company_id SET DEFAULT get_current_company_id();

-- FK to companies
ALTER TABLE public.audit_inventario_log
  ADD CONSTRAINT audit_inventario_log_company_fk
  FOREIGN KEY (company_id) REFERENCES public.companies(id);

-- Index for tenant queries
CREATE INDEX IF NOT EXISTS idx_audit_inv_log_company_created
  ON public.audit_inventario_log (company_id, created_at DESC);

-- Drop legacy policies
DROP POLICY IF EXISTS "inventory_read_audit_log" ON public.audit_inventario_log;
DROP POLICY IF EXISTS "inventory_insert_audit_log" ON public.audit_inventario_log;

-- New tenant-safe policies
CREATE POLICY "inventario:auditoria:view audit_log"
  ON public.audit_inventario_log FOR SELECT TO authenticated
  USING (
    company_id = get_current_company_id()
    AND has_any_permission(auth.uid(), ARRAY['inventario:auditoria:view', 'system:global:manage'])
  );

CREATE POLICY "inventario:audit_log insert via server"
  ON public.audit_inventario_log FOR INSERT TO authenticated
  WITH CHECK (company_id = get_current_company_id());

-- Immutable: no UPDATE/DELETE for normal users
CREATE POLICY "inventario:audit_log no_update"
  ON public.audit_inventario_log FOR UPDATE TO authenticated
  USING (false);

CREATE POLICY "inventario:audit_log no_delete"
  ON public.audit_inventario_log FOR DELETE TO authenticated
  USING (false);

-- Block placeholder company
CREATE TRIGGER trg_block_placeholder_company
  BEFORE INSERT OR UPDATE ON public.audit_inventario_log
  FOR EACH ROW EXECUTE FUNCTION trg_block_placeholder_company();

-- ── H1: FORCE RLS ON all inventory tables ──

ALTER TABLE public.inventarios FORCE ROW LEVEL SECURITY;
ALTER TABLE public.inventario_itens FORCE ROW LEVEL SECURITY;
ALTER TABLE public.audit_inventario_log FORCE ROW LEVEL SECURITY;
ALTER TABLE public.turnos FORCE ROW LEVEL SECURITY;

-- ── H2: Idempotency for inventory creation ──

ALTER TABLE public.inventarios
  ADD COLUMN IF NOT EXISTS idempotency_key text;

CREATE UNIQUE INDEX IF NOT EXISTS uq_inventarios_company_idempotency
  ON public.inventarios (company_id, idempotency_key)
  WHERE idempotency_key IS NOT NULL AND deleted_at IS NULL;

-- ── H3: Block hard DELETE on critical tables ──

-- inventarios: block hard delete
CREATE POLICY "inventario:no_hard_delete inventarios"
  ON public.inventarios FOR DELETE TO authenticated
  USING (false);

-- inventario_itens: block hard delete
CREATE POLICY "inventario:no_hard_delete itens"
  ON public.inventario_itens FOR DELETE TO authenticated
  USING (false);

-- ── W3: Fix turnos SELECT policy (USING true → tenant-safe) ──

DROP POLICY IF EXISTS "Authenticated can read turnos" ON public.turnos;

-- Keep the existing perm_turnos_select with settings:manage,
-- but add a tenant-safe read for inventory users
CREATE POLICY "inventario:turnos:view"
  ON public.turnos FOR SELECT TO authenticated
  USING (company_id = get_current_company_id());

-- ── W1: Add updated_at triggers (server-side, no client new Date()) ──

CREATE OR REPLACE FUNCTION public.trg_set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = now();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql SET search_path = public;

CREATE TRIGGER trg_set_updated_at_inventarios
  BEFORE UPDATE ON public.inventarios
  FOR EACH ROW EXECUTE FUNCTION trg_set_updated_at();

CREATE TRIGGER trg_set_updated_at_inventario_itens
  BEFORE UPDATE ON public.inventario_itens
  FOR EACH ROW EXECUTE FUNCTION trg_set_updated_at();

-- ── H2 continued: create_inventory_atomic RPC ──

CREATE OR REPLACE FUNCTION public.create_inventory_atomic(
  p_tipo text,
  p_data date,
  p_hora time,
  p_turno_id uuid,
  p_categorias text[] DEFAULT '{}',
  p_observacao text DEFAULT '',
  p_idempotency_key text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public, pg_temp
AS $$
DECLARE
  v_tenant uuid;
  v_user_id uuid;
  v_inv_id uuid;
  v_existing_id uuid;
  v_produtos_ids uuid[];
  v_itens_count int := 0;
BEGIN
  v_tenant := assert_tenant();
  v_user_id := auth.uid();
  IF v_user_id IS NULL THEN RAISE EXCEPTION 'Não autenticado'; END IF;

  IF NOT has_any_permission(v_user_id, ARRAY['inventario:criar:create', 'system:global:manage']) THEN
    RAISE EXCEPTION 'Forbidden: inventario:criar:create required';
  END IF;

  -- Idempotency check
  IF p_idempotency_key IS NOT NULL THEN
    SELECT id INTO v_existing_id
    FROM inventarios
    WHERE company_id = v_tenant
      AND idempotency_key = p_idempotency_key
      AND deleted_at IS NULL;

    IF FOUND THEN
      RETURN jsonb_build_object(
        'inventario_id', v_existing_id,
        'idempotent', true,
        'itens_count', (SELECT count(*) FROM inventario_itens WHERE inventario_id = v_existing_id AND deleted_at IS NULL)
      );
    END IF;
  END IF;

  -- Create inventory
  INSERT INTO inventarios (
    company_id, tipo, data, hora, turno_id, categorias,
    responsavel_user_id, observacao, status, idempotency_key
  ) VALUES (
    v_tenant, p_tipo, p_data, p_hora, p_turno_id, COALESCE(p_categorias, '{}'),
    v_user_id, COALESCE(p_observacao, ''), 'RASCUNHO', p_idempotency_key
  )
  RETURNING id INTO v_inv_id;

  -- Resolve products based on type
  IF p_tipo = 'completo' THEN
    SELECT array_agg(id) INTO v_produtos_ids
    FROM produtos WHERE ativo = true AND company_id = v_tenant;
  ELSIF p_tipo = 'parcial' AND array_length(p_categorias, 1) > 0 THEN
    SELECT array_agg(id) INTO v_produtos_ids
    FROM produtos WHERE ativo = true AND company_id = v_tenant AND categoria = ANY(p_categorias);
  ELSIF p_tipo = 'ciclico' THEN
    SELECT array_agg(id) INTO v_produtos_ids
    FROM (
      SELECT p.id
      FROM produtos p
      WHERE p.ativo = true AND p.company_id = v_tenant
      ORDER BY COALESCE(p.custo_padrao, 0) DESC
      LIMIT 20
    ) sub;
  END IF;

  -- Bulk insert items with saldo from RPC
  IF v_produtos_ids IS NOT NULL AND array_length(v_produtos_ids, 1) > 0 THEN
    INSERT INTO inventario_itens (company_id, inventario_id, produto_id, tipo_item, saldo_teorico, custo_snapshot)
    SELECT
      v_tenant,
      v_inv_id,
      sp.produto_id,
      'geral',
      GREATEST(0, COALESCE(sp.saldo, 0)),
      COALESCE(sp.custo_medio, 0)
    FROM get_saldo_produtos(v_produtos_ids) sp;

    GET DIAGNOSTICS v_itens_count = ROW_COUNT;
  END IF;

  -- Audit
  INSERT INTO audit_inventario_log (company_id, inventario_id, user_id, user_role, acao, depois)
  VALUES (
    v_tenant, v_inv_id, v_user_id,
    COALESCE((SELECT string_agg(role::text, ',') FROM user_roles WHERE user_id = v_user_id), 'unknown'),
    'CRIACAO',
    jsonb_build_object('tipo', p_tipo, 'turno_id', p_turno_id, 'itens_count', v_itens_count)
  );

  RETURN jsonb_build_object('inventario_id', v_inv_id, 'idempotent', false, 'itens_count', v_itens_count);
END;
$$;
